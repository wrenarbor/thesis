
@article{zimman_beyond_2021,
	title = {Beyond the cis gays’ cis gaze: The need for a trans linguistics},
	volume = {15},
	issn = {1747-633X, 1747-6321},
	url = {https://journal.equinoxpub.com/GL/article/view/20883},
	doi = {10.1558/genl.20883},
	shorttitle = {Beyond the cis gays’ cis gaze},
	abstract = {Trans and other nonnormatively gendered subjectivities served a foundational role in queer linguistics, but it is only recently that a wave of trans researchers have begun to carve out distinctively trans approaches to the study of language. This commentary explores the question of why this shift has taken so long and how certain disciplinary norms have made linguistics a less-than-attractive home for trans scholars, namely an apoliticised ideology of descriptivism, the flippant indulgence of linguistic curiosity and claims to linguistic authority. Importantly, these processes are vulnerable to furthering not only transphobia but also racism, colonialism, ableism and linguistic subjugation. These convergences present opportunities for coalition-based responses to the maintenance of social hierarchies in linguistics and allied disciplines, and underscore the importance of community-based approaches to research on language and gender alterity.},
	number = {3},
	journaltitle = {Gender and Language},
	shortjournal = {{GENL}},
	author = {Zimman, Lal},
	urldate = {2024-12-19},
	date = {2021-10-06},
	langid = {english},
	file = {PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\G7KL96JJ\\Zimman - 2021 - Beyond the cis gays’ cis gaze The need for a trans linguistics.pdf:application/pdf},
	annotation = {The `trans linguistics' that Zimman proposes is a philosophy I take up here. Additionally, I take up the idea of linguistic descriptivism as an apoliticized language ideology.}
}


@incollection{zimman_transgender_2020,
	title = {Transgender Language, Transgender Moment: Toward a Trans Linguistics},
	isbn = {978-0-19-021292-6},
	url = {https://doi.org/10.1093/oxfordhb/9780190212926.013.45},
	shorttitle = {Transgender Language, Transgender Moment},
	abstract = {This chapter sketches out trans linguistics as an emerging framework for research on language in populations defined by their deviation from gender norms. Although queer linguistics has always been concerned with both sexual and gender (non)normativity, some early queer linguistic analyses of transgender or otherwise gender-variant populations were limited by the absence of openly trans scholars and distinctively trans analytic perspectives. Trans linguistics, by contrast, centers trans practices and subjectivities not as rare exceptions, but as central to any understanding of gender. Three domains of language are discussed here, including grammatical gender, gender difference in the voice, and gender in discourse. In each case, trans linguistic research offers new perspectives on gendered power, the nature of categories, the significance of embodiment, and the linguistic navigation of persistent dehumanization. Crucially, trans linguistics is committed not only to trans analytic lenses, but also to social and linguistic justice for gender non-normative communities.},
	pages = {0},
	booktitle = {The Oxford Handbook of Language and Sexuality},
	publisher = {Oxford University Press},
	author = {Zimman, Lal},
	editor = {Hall, Kira and Barrett, Rusty},
	urldate = {2024-12-19},
	date = {2020},
	doi = {10.1093/oxfordhb/9780190212926.013.45},
	keywords = {Trans Linguistics},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\PWTXVJ6R\\Zimman - Transgender Language, Transgender Moment Toward a Trans Linguistics.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\NVERUV84\\358161844.html:text/html},
	annotation = {This paper reviews thirty years of literature on linguistic research on transgender people, as well as other groups which do not fit within the Western gender binary, and proposes `trans linguistics', a framework which I adopt.}
}



@incollection{livia_its_1997,
	title = {“It's a Girl!”: Bringing Perfarmativity Back to Linguistics},
	isbn = {978-0-19-510470-7},
	url = {https://doi.org/10.1093/oso/9780195104707.003.0001},
	shorttitle = {“It's a Girl!”},
	abstract = {We began collecting articles for this volume in March 1994 while preparations for the third Berkeley Women and Language Conference ({BWLC}) were at their height. In our own papers for the 1994 conference, we were each grappling with recent developments in queer theory and its uneasy, often antagonistic, relation to feminist theory. So, as it turned out, were several of the other conference participants that year. During the two previous decades, although a substantial body of research had been carried out on language and gender, few of these studies had taken sexuality, or sexual orientation, as a criterion for analysis, and the vast majority assumed gender as an unproblematic category indexically linked to the sex of the speaker or writer.},
	pages = {0},
	booktitle = {Queerly Phrased: Language, Gender, and Sexuality},
	publisher = {Oxford University Press},
	author = {Livia, Anna and Hall, Kira},
	editor = {Livia, Anna and Hall, Kira},
	urldate = {2025-04-08},
	date = {1997-11-20},
	doi = {10.1093/oso/9780195104707.003.0001},
	file = {PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\34TCIW99\\Livia and Hall - 1997 - Its a Girl!” Bringing Perfarmativity Back to Linguistics.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\Z8NHZJZ3\\421391551.html:text/html},
	annotation = {I reference this introduction's discussion of the history of language and SGS scholarship up to 1997, specifically its discussion of the theoretical ties and tensions between the sociolinguistic literature and other fields including queer theory, feminism, and literary theory.}
}


@thesis{hazenberg_language_2012,
	title = {Language and identity practice : a sociolinguistic study of gender in Ottawa, Ontario},
	rights = {thesis\_license},
	url = {https://research.library.mun.ca/2346/},
	shorttitle = {Language and identity practice},
	abstract = {[S]ocial identity is not usually explicitly encoded by language but rather is a social meaning that one usually infers on the basis of one's sense of [...] linguistic constructions. -- (Ochs, 1993: 289) -- Contemporary theories posit that gender is performative (e.g., Butler, 1990): that it is something one does rather than something one has. Early variationist sociolinguists (e.g., Labov, 1963) saw sex as a social variable, while later researchers (e.g., Livia \& Hall, 1997) focused instead on gender, including expressions of sexuality. The study of transsexuality and language variation is a recent addition to the field (e.g., Kulick. 1999). -- This study examines three sociolinguistic variables ([s], intensifiers, and prosodic variation) across a six-cell gender division (straight men and women, queer men and women, and transsexual men and women) in Ottawa, Canada, to investigate the linguistic resources that are used in the construction and presentation of gender. These variables show different patterns of usage across the gender groups, suggesting a relationship between the markedness of a variable (how aware speakers are that it indexes gender) and the strategies speakers adopt in using it. Transsexual speakers avoid using extremely gender-marked forms, while straight men use linguistic cues to distance themselves socially from queer men. These patterns are supported by Bucholtz \& Hall's (2005) framework of sociocultural linguistics, which argues for an interactional model of identity and performance.},
	institution = {Memorial University of Newfoundland},
	type = {masters},
	author = {Hazenberg, Evan Nicholas Leo},
	urldate = {2025-04-05},
	date = {2012},
	langid = {english},
	keywords = {/s/, Transgender Women, Transgender Men},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\CH3V5JRE\\Hazenberg - 2012 - Language and identity practice  a sociolinguistic study of gender in Ottawa, Ontario.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\27WXQY68\\2346.html:text/html},
	annotation = {A study of /s/ production in Ottowa, Ontario which includes trans women. One of the sources in my primary prior literature, I refer to its findings that trans women's /s/ production was significantly different from cis people's, and closer to cis women's than to cis men's.}
}


@incollection{podesva_sexuality_2015,
	title = {/s/exuality in Smalltown California: Gender Normativity and the Acoustic Realization of /s/},
	isbn = {978-0-19-021036-6},
	url = {https://doi.org/10.1093/acprof:oso/9780190210366.003.0009},
	shorttitle = {/s/exuality in Smalltown California},
	abstract = {Recent sociophonetic work on /s/ reveals that sex, gender, and sexual orientation strongly structure variation in the acoustic signal. This chapter acoustically analyzes /s/ production for fifty-one speakers from an inland community in Northern California. It is found that the speakers generally conform to normative patterns (e.g., straight women have fronter /s/ than straight men). At the same time, while /s/ realizations for gay men and lesbians fall within the ranges of their straight counterparts, we find significant differences between straight and {LGBT} speakers. Moreover, the different gender/sexuality groups in the community in this study produce more extreme variants of /s/ than do their counterparts in urban studies. For example, men and women are even more acoustically distinct from each other, and gay men exhibit much backer /s/. The chapter concludes that political and religious conservativism in the community polarizes gender distinction and pressures sexual minorities to adhere to normative gender patterns.},
	pages = {168--188},
	booktitle = {Language, Sexuality, and Power: Studies in Intersectional Sociolinguistics},
	publisher = {Oxford University Press},
	author = {Podesva, Robert J. and Van Hofwegen, Janneke},
	editor = {Levon, Erez and Mendes, Ronald Beline},
	urldate = {2025-04-05},
	date = {2015-12-24},
	doi = {10.1093/acprof:oso/9780190210366.003.0009},
	keywords = {/s/, Transgender Men, Transgender Women},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\DTB7LJ24\\Podesva and Hofwegen - 2015 - sexuality in Smalltown California Gender Normativity and the Acoustic Realization of s.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\UG7ZPK8S\\151105120.html:text/html},
	annotation = {A study of /s/ production in Redding, California, which includes trans women. Similar to \textcite{hazenberg_language_2012}, finds significant differences between trans people and cis people, however also finds that trans people's /s/ patterns more with AGAB than gender identity; this is possibly due to the conservative nature of the town. I reference the data the paper finds on trans women's /s/ pronunciations.}
}


@article{campbell-kibler_intersecting_2011,
	title = {Intersecting Variables and Perceived Sexual Orientation in Men},
	volume = {86},
	issn = {0003-1283},
	url = {https://doi.org/10.1215/00031283-1277510},
	doi = {10.1215/00031283-1277510},
	abstract = {Sociolinguistic styles tie linguistic resources together into clusters and link them to social contexts of times, groups, places, and activities. Perceptions of masculinity and sexual orientation represent a well-studied area on sociolinguistic perception, offering many variables with potentially relevant social meanings. This study examines social perceptions of guises created by intersecting three masculinity-relevant variables: pitch, /s/-fronting or backing, and ({ING}). First, 110 online respondents provided descriptions and naturalness ratings of speech samples that were digitially modified to include the different variants; next, 175 respondents rated the speakers on six-point scales based on the terms “smart,” “knowledgeable,” “masculine,” “gay,” “friendly,” “laid-back,” “country,” “educated,” and “confident.” The results showed that /s/-fronting carries strong social meaning across multiple speakers and other linguistic cues, making speakers sound less masculine, more gay and less competent. As documented elsewhere, use of the ({ING}) variants -ing and -in made speakers sound more or less competent, respectively. The combination of /s/-fronting and ({ING}), and, independently, /s/-backing, showed more complex effects, shifting relationships between multiple percepts. Taken together, these results provide some support for style-based sociolinguistic models, but also underline the need for more sophisticated statistical treatments of covariation in social perception.},
	pages = {52--68},
	number = {1},
	journaltitle = {American Speech},
	shortjournal = {American Speech},
	author = {Campbell-Kibler, Kathryn},
	urldate = {2025-04-05},
	date = {2011-02-01},
	file = {Campbell Kibler 2011.pdf:C\:\\Users\\School Dylan King\\Zotero\\storage\\ULGT4N5Q\\Campbell Kibler 2011.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\A7G8D5AQ\\Intersecting-Variables-and-Perceived-Sexual.html:text/html},
	annotation = {A perception study of /s/ which finds social meanings of ``less masculine, more gay, and less competent'' arise for fronted /s/ within certain stylistic contexts of an (otherwise) male-sounding voice. I use this as one of the baseline studies of the hegemonic meanings of /s/.}
}


@incollection{calder_gay_2020,
	edition = {1},
	title = {From “Gay Lisp” to “Fierce Queen”: The Sociophonetics of Sexuality’s Most Iconic Variable},
	isbn = {978-0-19-021292-6 978-0-19-021294-0},
	url = {https://academic.oup.com/edited-volume/42645/chapter/358158508},
	shorttitle = {From “Gay Lisp” to “Fierce Queen”},
	abstract = {Abstract
            The sound of the queer voice has captured the intrigue of the popular and sociolinguistic imagination, spurring a wave of research investigating what makes someone “sound gay.” This chapter follows the trajectory of the sociophonetics of {LGBTQ}+ speakers, focusing on what is perhaps the most robustly studied phonetic variable in queer linguistics: the /s/ sound. The chapter explores how a group of non-normative drag queens in San Francisco use acoustic dimensions of /s/ to project radical queerness, illustrating how this community’s practices bear on greater conversations in sociolinguistics involving the connection between phonetic variation and the articulation of identity.},
	booktitle = {The Oxford Handbook of Language and Sexuality},
	publisher = {Oxford University Press},
	author = {Calder, J},
	editor = {Hall, Kira and Barrett, Rusty},
	urldate = {2025-04-05},
	date = {2020-12-15},
	langid = {english},
	doi = {10.1093/oxfordhb/9780190212926.013.49},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\NJ5RWBRI\\Calder - From “Gay Lisp” to “Fierce Queen” The Sociophonetics of Sexuality’s Most Iconic Variable.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\AVPSTDNC\\358158508.html:text/html},
	annotation = {Part of Calder's work on SoMa drag queens, I use this paper for its review of prior literature on /s/, and engage with its conceptualization of /s/'s iconicity.}
}


@article{calder_sissy_2019,
	title = {From Sissy to Sickening: The Indexical Landscape of /s/ in {SoMa}, San Francisco},
	volume = {29},
	rights = {© 2019 American Anthropological Association},
	issn = {1548-1395},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/jola.12218},
	doi = {10.1111/jola.12218},
	shorttitle = {From Sissy to Sickening},
	abstract = {This paper explores the relation between the linguistic and the visual in indexing social meaning and performing gender, focusing on fronted /s/ among a community of drag queens in {SoMa}, San Francisco. I argue that as orders of indexicality (Silverstein 2003) are established, linguistic features like fronted /s/ become linked with visual bodies. These body-language links can impose top-down restrictions on the uptake of gender performances. Non-normatively gendered individuals like the {SoMa} queens embody cross-modal figures of personhood (see Agha 2003, 2004) like the fierce queen that forge higher indexical orders and widen the range of performative agency.},
	pages = {332--358},
	number = {3},
	journaltitle = {Journal of Linguistic Anthropology},
	author = {Calder, J},
	urldate = {2025-04-04},
	date = {2019},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/jola.12218},
	keywords = {Indexicality, Performativity, Style, Indexical Field, Indexical Orders, Indexical Baptism, Gender Baptism, Queer linguistics, Cross-modality, Fractal Recursivity},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\IIMESCMG\\Calder - 2019 - From Sissy to Sickening The Indexical Landscape of s in SoMa, San Francisco.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\H6A55IC2\\jola.html:text/html},
	annotation = {Part of Calder's work on SoMa drag queens, I use this paper for its discussion of the indexicality of /s/:  it theorizes meanings of /s/ as belonging to indexical orders which form along strata of fractal recursivity, and raises the insight that the presentation of the body is part of the stylistic context which determines at which indexical order /s/ behavior will be interpreted through.}
}


@article{silverstein_indexical_2003,
	title = {Indexical order and the dialectics of sociolinguistic life},
	volume = {23},
	issn = {0271-5309},
	url = {https://www.sciencedirect.com/science/article/pii/S0271530903000132},
	doi = {10.1016/S0271-5309(03)00013-2},
	series = {Words and Beyond: Linguistic and Semiotic Studies of Sociocultural Order},
	abstract = {The concept of indexical order is introduced, necessary to any empirical investigation of the inherently dialectical facts of indexicality. Indexical order is central to analyzing how semiotic agents access macro-sociological plane categories and concepts as values in the indexable realm of the micro-contextual. Through such access their relational identities are presupposed and creatively (trans)formed in interaction. We work through several classic examples of indexicality well-known in the literature of sociolinguistics, the clarification of which can be enhanced by using the concept of indexical order, viz., ‘T/V’ deference-indexicality, speech levels, indexically significant variation in phonetics informed by a standard phonological register. We conclude with an analysis of identity-commoditizing indexical overlays such as the American English register here dubbed “oinoglossia,” ‘wine talk’.},
	pages = {193--229},
	number = {3},
	journaltitle = {Language \& Communication},
	shortjournal = {Language \& Communication},
	author = {Silverstein, Michael},
	urldate = {2025-04-09},
	date = {2003-07-01},
	keywords = {Honorifics, Indexicality, Language ideology, Political economy of language, Registers, Sociolinguistic variation},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\LQ84N3SG\\Silverstein - 2003 - Indexical order and the dialectics of sociolinguistic life.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\AZV59K9W\\S0271530903000132.html:text/html},
	annotation = {I take up the concept of indexical orders as introduced in this paper.}
}


