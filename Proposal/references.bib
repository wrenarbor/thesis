@thesis{heffernan_constructing_2023,
	title = {Constructing the “Cisgender Listening Subject”: Trans-Feminine Speakers’ Commentaries on Voice and Being Heard},
	url = {https://escholarship.org/uc/item/5568m53k},
	shorttitle = {Constructing the “Cisgender Listening Subject”},
	abstract = {This thesis examines metalinguistic commentaries of trans-feminine individuals about voice and voice modification as a site of language ideological work. Language ideologies are positioned, multiple, and mediating views on language and language use (Kroskrity 2004). Based on data collected through a recorded semi-structured conversation and from an online forum dedicated to trans voice modification, I illustrate how some trans-feminine speakers construe the pursuit of voice modification as affirming while simultaneously scrutinizing the practice of ascribing gender to someone based on their voice. Furthermore, I explore how these commentaries tacitly characterize the “cisgender listening subject” (Calder 2021) – an ideological position which apprehends voices through the logics of a binary gender system – and interrogate the listening practices of this subject. These discursive moves reflect the entanglement of creativity and discipline in voice practices (Weidman 2006), including voice modification, emerging here within and between views of gender as self-determined, on the one hand, and of gender as intersubjectively constituted, on the other.},
	institution = {{UCLA}},
	type = {phdthesis},
	author = {Heffernan, Dani},
	urldate = {2025-04-06},
	date = {2023},
	langid = {english},
	keywords = {Transgender Women, Discourse Analysis, Cisgender Listening Subject, Metalinguistic Commentary},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\3H8MLWM4\\Heffernan - 2023 - Constructing the “Cisgender Listening Subject” Trans-Feminine Speakers’ Commentaries on Voice and B.pdf:application/pdf},
	annotation = {This study of transfeminine people's metalinguistic commentaries about the voice and being heard emphasizes the importance of the concept of the listening subject (see \cite{calder_whose_2021, flores_undoing_2015, inoue_listening_2003}). I use this for its findings on transfeminine people's understanding of the cis gaze.}
}


