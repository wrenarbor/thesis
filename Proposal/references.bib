	isbn = {978-0-19-021036-6},
	url = {https://doi.org/10.1093/acprof:oso/9780190210366.003.0005},
	booktitle = {Language, Sexuality, and Power: Studies in Intersectional Sociolinguistics},
	publisher = {Oxford University Press},
	author = {Maegaard, Marie and Pharao, Nicolai},
	date = {2015-12},
	doi = {10.1093/acprof:oso/9780190210366.003.0005},
	doi = {10.1093/acprof:oso/9780190210366.003.0005},
	note = {\_eprint: https://academic.oup.com/book/0/chapter/151100575/chapter-ag-pdf/44978028/book\_6883\_section\_151100575.ag.pdf},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\8L3J2GTH\\Maegaard and Pharao - 2015 - s Variation and Perceptions of Male Sexuality in Denmark.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\BIZRXXQY\\151100575.html:text/html},
	annotation = {This perception study of /s/ in Danish finds that although fronting is linked to the expected meanings of femininity and gayness when situated in a male voice, these associations do not hold in the context of a prosodic style associated with immigrants, showing the typically-associated meanings of /s/ to be hegemonic and ascribed to to white middle class contexts. I use this paper as an example of research which reveals the typical meaning structure of /s/ to be white.}
}


@article{zimman_hegemonic_2013,
	title = {Hegemonic masculinity and the variability of gay-sounding speech: The perceived sexuality of transgender men},
	volume = {2},
	issn = {2211-3770, 2211-3789},
	url = {http://www.jbe-platform.com/content/journals/10.1075/jls.2.1.01zim},
	doi = {10.1075/jls.2.1.01zim},
	shorttitle = {Hegemonic masculinity and the variability of gay-sounding speech},
	abstract = {Sociophonetic inquiry into sexuality and the voice has often focused on the perception of men’s sexuality on the basis of disembodied voices. However, inconsistencies across these studies limit our ability to unite their findings into a cohesive model of gay-sounding speech. This paper focuses on variability among gay-sounding speakers by analyzing the voices of female-to-male transgender individuals, or trans men. Trans men who make use of testosterone typically experience a significant drop in vocal pitch, yet may maintain stylistic traits acquired while living in a female social role. An acoustic and perceptual analysis of trans and non-trans men’s voices reveals that even as trans men may be perceived as gay-sounding, their sociolinguistic styles also differ from those of gay-sounding non-trans men. These findings support the notion that gay-sounding speech does not constitute a single phonetic style, but rather numerous deviations from the hegemonic norm.},
	pages = {1--39},
	number = {1},
	journaltitle = {Journal of Language and Sexuality},
	shortjournal = {{JLS}},
	author = {Zimman, Lal},
	urldate = {2025-04-04},
	date = {2013-02-27},
	langid = {english},
	file = {PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\I7AYTI7H\\Zimman - 2013 - Hegemonic masculinity and the variability of gay-sounding speech The perceived sexuality of transge.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\P64GNW9F\\jls.2.1.html:text/html},
	annotation = {This combined production-perception study of /s/, trans men's /s/ behavior is shown to significantly differ from cis men's, but (cis) percievers nonetheless rated them as gay sounding. I'm interested in this data, especially its consideration of the interplay between production and perception, and also interested in its discussion of the meaning structure for /s/ as hegemonic.}
}


