@article{holmes-elliott_substance_2017,
	title = {The substance of style: Gender, social class and interactional stance in /s/-fronting in southeast England},
	volume = {55},
	rights = {De Gruyter expressly reserves the right to use all content for commercial text and data mining within the meaning of Section 44b of the German Copyright Act.},
	issn = {1613-396X},
	url = {https://www.degruyterbrill.com/document/doi/10.1515/ling-2017-0020/html},
	doi = {10.1515/ling-2017-0020},
	shorttitle = {The substance of style},
	abstract = {This paper proposes an empirical method for the quantitative analysis of stance-taking in interaction. Building on recent conceptualizations of stance as the primary building-block of variation in language style, we describe how to implement an analysis of stance within a variationist framework via an examination of the particular speech activities within which stances are embedded combined with a consideration of the specific interactional goals these activities achieve. We illustrate our proposals with an investigation of variation in /s/-quality in the speech of cast members from two British reality television programs. Examining nearly 2000 tokens of /s/ in over 6 hours of recorded speech, we demonstrate how different acoustic realizations of /s/ in the sample correlate with the level of “threat” of a given speech activity, and we argue that this interactionally based analysis provides a better explanatory account of the patterns in our data than an analysis based on large social categories would. Through this paper, we therefore hope to contribute not only to the development of a more robust method for examining stance in quantitative sociolinguistic research, but also to help clarify the relationship between stances, speech activities and speaker identities more broadly.},
	pages = {1045--1072},
	number = {5},
	journaltitle = {Linguistics},
	author = {Holmes-Elliott, Sophie and Levon, Erez},
	urldate = {2025-09-27},
	date = {2017-09-01},
	langid = {english},
	note = {Publisher: De Gruyter Mouton},
	keywords = {/s/-fronting, language variation, southeast England, stance, stance accretion, style},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\I2Z9USWG\\Holmes-Elliott and Levon - 2017 - The substance of style Gender, social class and interactional stance in s-fronting in southeast E.pdf:application/pdf},
	annotation = {This study of /s/ and style reveals style-shifting of /s/ to pertain not only to gender, but aditionally to stance. I take this into consideration in the design of my methodology.}
}


@incollection{rickford_addressee_1994,
	title = {Addressee- And Topic-Influenced Style Shift: A Quantitative Sociolinguistic Study},
	shorttitle = {Addressee-And Topic-Influenced Style Shift},
	abstract = {Abstract This chapter is a study of addressee-and topic-influenced style shift in language, within the framework of quantitative or “variationist” sociolinguistics. The first section is written from a theoretical, history-of-science perspective; we begin by contrasting the taxonomic, polydimensional approach of sociolinguists like Hymes (1972) and Halliday (1978) with the empirical, unidimensional approach of Labov (1966:90-135, 1972a:70-109), for whom styles were ordered on a single dimension, involving attention paid to speech. We suggest that the neglect of style within the American variationist school from the 1970s onward was due in part to methodological and theoretical difficulties with this approach. As we note, an alternative unidimensional approach, considering style as audience accommodation (Giles and Powesland 1975, Bell 1984), is more promising, but although several quantitative studies within this framework have been made over the past decade and a half, most of them were done outside the United States, primarily in Britain.},
	pages = {235--276},
	booktitle = {Sociolinguistic Perspectives On Register},
	author = {Rickford, John R and Mcnair-Knox, Faye},
	date = {1994},
	doi = {10.1093/oso/9780195083644.003.0011},
	keywords = {audience design, foxy boston},
	file = {PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\JQYNR6DU\\Rickford and Mcnair-Knox - 1994 - Addressee-And Topic-Influenced Style Shift A Quantitative Sociolinguistic Study.pdf:application/pdf},
	annotation = {I cite this early work on AAE style-shifting in my definition of the term `interlocutor-oriented style-shifting'.}
}


@article{flipsen_acoustic_1999,
	title = {Acoustic Characteristics of /s/ in Adolescents},
	volume = {42},
	issn = {1092-4388},
	doi = {10.1044/jslhr.4203.663},
	abstract = {The goal of the current study was to construct a reference database against which misarticulations of /s/ can be compared. Acoustic data for 26 typically speaking 9- to 15-year-olds were examined to resolve measurement issues in acoustic analyses, including alternative sampling points within the /s/ frication; the informativeness of linear versus Bark transformations of each of the 4 spectral moments of /s/ (Forrest, Weismer, Milenkovic, \& Dougall, 1988); and measurement effects associated with linguistic context, age, and sex. Analysis of the reference data set indicates that acoustic characterization of /s/ is appropriately and optimally (a) obtained from the midpoint of /s/, (b) represented in linear scale, (c) reflected in summary statistics for the 1st and 3rd spectral moments, (d) referenced to individual linguistic-phonetic contexts, (e) collapsed across the age range studied, and (f) described individually by sex.},
	pages = {663--677},
	number = {3},
	journaltitle = {Journal of speech, language, and hearing research},
	author = {Flipsen, Peter and Shriberg, Lawrence and Weismer, Gary and Karlsson, Heather and {McSweeny}, Jane},
	date = {1999},
	note = {Place: United States
Publisher: {ASHA}},
	keywords = {Acoustics, Algorithms, Articulation disorders, Child Language, Data Analysis, Data Collection, Female, Human beings, Linguistics, Male, Phonetics, Phonetics, Acoustic, Phonology, Preteens, Reproducibility of Results, Sample Size, Sampling, Sex differences, Speech, Speech Acoustics, Speech disorders, Speech Production Measurement, Teenagers},
	file = {Full text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\FCWZMUHW\\Flipsen Jr. and Shriberg - 1999 - Acoustic Characteristics of s in Adolescents..pdf:application/pdf},
	annotation = {I use this paper as a reference on ``typical'' /s/ pronunciations in the cishet white western normative english sphere, esp. for its review of 21 prior studies on /s/.}
}



@article{calder_whose_2022,
	title = {Whose gendered voices matter?: Race and gender in the articulation of /s/ in Bakersfield, California},
	volume = {26},
	rights = {© 2022 John Wiley \& Sons Ltd.},
	issn = {1467-9841},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/josl.12584},
	doi = {10.1111/josl.12584},
	shorttitle = {Whose gendered voices matter?},
	abstract = {/s/ frontness is one of the most robustly studied linguistic variables in language and gender research. While much previous literature has established the pattern that women produce fronter /s/ than men, production work on /s/ has either largely focused on White speakers or left speaker race unexplored. This article addresses this gap by examining the production of /s/ among African American and White speakers in Bakersfield, California. While the White speakers exhibit a gender split consonant with previous studies, African American Bakersfieldians exhibit no gender split, with African American men producing /s/ as front as African American women. We argue that African American men in Bakersfield avoid a backed production of /s/ indexical of a White country identity which has historically oppressed them in the area. These production patterns illuminate the importance of an intersectional analysis, taking into account the effect of speaker race on gendered variables like /s/.},
	pages = {604--623},
	number = {5},
	journaltitle = {Journal of Sociolinguistics},
	author = {Calder, J. and King, Sharese},
	urldate = {2025-04-05},
	date = {2022},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/josl.12584},
	keywords = {Indexicality, /s/, Intersectionality, Race},
	file = {Full Text PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\8QVGJ4VT\\Calder and King - 2022 - Whose gendered voices matter Race and gender in the articulation of s in Bakersfield, California.pdf:application/pdf;Snapshot:C\:\\Users\\School Dylan King\\Zotero\\storage\\WQP9HKHG\\josl.html:text/html},
	annotation = {I use this paper as an example of a raciolinguistic approach to the study of /s/ which attempts to decenter the white indexical field, and illustrates the whiteness of the traditional sociolinguistics structure of /s/ meanings.}
}


@article{barrett_sexuality_2024,
	title = {Sexuality Discourses: Indexical Misrecognition and the Politics of Sex},
	volume = {53},
	issn = {0084-6570, 1545-4290},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-anthro-052721-092531},
	doi = {10.1146/annurev-anthro-052721-092531},
	shorttitle = {Sexuality Discourses},
	abstract = {This review of research on sexuality discourses directs attention to the patterns of indexical disalignment that have facilitated the global rise of transphobic, homophobic, and misogynist discourses. Over the last two decades, scholarship in the area of language and sexuality has focused primarily on patterns of alignment in the community-based indexical production of social personae, a necessary move for establishing the discursive agency, and indeed humanity, of {LGBTQ}+ groups. The focus of this review, however, is not alignment but disalignment, for it is in the clash of indexical systems that sexual ideologies take root. Specifically, the article focuses on acts of misrecognition that arise at the boundaries of indexical meaning, identifying practices such as indexical inoculation, indexical presumption, and indexical denial. The review is designed to provoke future research on misrecognition as contextualized social practice, a turn we believe imperative for uncovering the power-laden infrastructure of sexuality discourses.},
	pages = {127--146},
	issue = {Volume 53, 2024},
	journaltitle = {Annual Review of Anthropology},
	author = {Barrett, Rusty and Hall, Kira},
	urldate = {2025-09-13},
	date = {2024-10-21},
	langid = {english},
	note = {Publisher: Annual Reviews},
	keywords = {Indexicality, Performativity, Indexical Order, Transphobia, Science, Indexical Relativity, Indexical Inventory, Indexical Alignment, Recognition, Indexical Field},
	file = {PDF:C\:\\Users\\School Dylan King\\Zotero\\storage\\2LBCAA2V\\Barrett and Hall - 2024 - Sexuality Discourses Indexical Misrecognition and the Politics of Sex.pdf:application/pdf},
	annotation = {I hope to engage with this theory which relativizes indexicality through the notion of individuals having their own indexical inventories (subsets of the whole indexical fields of the variables they are aware of) and considers misrecognition of indexical meanings a place for power to enter the indexicality structure, specifically whether it is consonant with, or in tension against, performativity theory and queer theory.}
}







